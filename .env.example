# ============================================================================
# VOICE BOT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your credentials
# Do NOT commit .env to git - it contains secrets
#
# Architecture: Telnyx PSTN → Telnyx Media Streaming WebSocket → GCP (STT/LLM/TTS) → WebSocket → Telnyx
#

# === GCP Configuration ===
GCP_PROJECT_ID=my-gcp-project
GCP_REGION=us-central1
# For local development: path to GCP service account JSON
# For Cloud Run: uses ADC (Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# === Telnyx Configuration (PSTN + Media Streaming) ===
TELNYX_API_KEY=pk_test_1234567890abcdef
TELNYX_PUBLIC_KEY=base64_encoded_public_key_here
TELNYX_SIP_CONNECTION_ID=sip_connection_id_here

# === STT Configuration (Optional) ===
# If not provided, Google Speech-to-Text will be used
# Only set this if you want to use Deepgram as the STT provider
DEEPGRAM_API_KEY=

# === Bot Configuration ===
BOT_PROFILE=simple_qa
BOT_DEFAULT_LANGUAGE=es-419
BOT_TTS_VOICE=es-US-Neural2-A

# === Firestore Collections ===
FIRESTORE_CALLS_COLLECTION=calls
FIRESTORE_TRANSCRIPTIONS_COLLECTION=transcriptions
FIRESTORE_CUSTOMERS_COLLECTION=customers
FIRESTORE_BOT_PROFILES_COLLECTION=bot_profiles

# === Pub/Sub Configuration ===
PUBSUB_TOPIC_CALL_EVENTS=voice-bot-call-events

# === Application Configuration ===
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
ENVIRONMENT=development

GEMINI_MODEL=gemini-2.5-pro
GCS_AUDIO_BUCKET=botvoz-call-audio
DJANGO_WEBHOOK_TIMEOUT_SECONDS=10

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. GCP Setup:
#    - Create a GCP project and enable:
#      * Google Cloud Speech-to-Text v2
#      * Google Cloud Text-to-Speech
#      * Vertex AI APIs
#      * Firestore
#      * Pub/Sub
#    - Create Service Account → download JSON credentials
#    - Place credentials.json in project root
#
# 2. Telnyx Setup:
#    - Create account at https://telnyx.com
#    - Buy a phone number
#    - Create SIP Connection for Media Streaming
#    - Set webhook URL: https://your-cloud-run-url/webhooks/telnyx
#    - Get API Key + Public Key
#
# 3. Local Development:
#    - Copy this file to .env
#    - Fill in GCP_PROJECT_ID and Telnyx credentials
#    - Run: python -m uvicorn src.api.app:create_app --factory --reload
#
# 4. Production Deployment:
#    - Store secrets in GCP Secret Manager
#    - Run: gcloud builds submit --config cloudbuild.yaml
#
